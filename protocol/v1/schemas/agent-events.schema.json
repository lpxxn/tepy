{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tepy.local/protocol/v1/agent-events.schema.json",
  "title": "Tepy agent v1 in-memory event page",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "session": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "observed_at": {
      "type": "integer",
      "minimum": 1
    },
    "capacity": {
      "const": 200
    },
    "oldest_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "latest_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "next_after": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "has_more": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "agent_started",
              "screen_locked",
              "screen_unlocked",
              "screen_lock_unknown",
              "will_sleep",
              "did_wake",
              "console_active",
              "console_inactive",
              "console_unknown",
              "hid_registered",
              "hid_absent",
              "hid_unknown",
              "mqtt_connected",
              "mqtt_disconnected",
              "mqtt_error",
              "power_monitor_ready",
              "power_monitor_unavailable"
            ]
          },
          "from": {
            "enum": [
              "",
              "running",
              "unknown",
              "active",
              "inactive",
              "locked",
              "unlocked",
              "registered",
              "absent",
              "sleeping",
              "awake",
              "unavailable",
              "ready",
              "connected",
              "disconnected"
            ]
          },
          "to": {
            "enum": [
              "",
              "running",
              "unknown",
              "active",
              "inactive",
              "locked",
              "unlocked",
              "registered",
              "absent",
              "sleeping",
              "awake",
              "unavailable",
              "ready",
              "connected",
              "disconnected"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^([a-z_]{1,64})?$"
          }
        },
        "required": [
          "sequence",
          "at",
          "kind",
          "from",
          "to",
          "code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "agent_id",
    "session",
    "observed_at",
    "capacity",
    "oldest_sequence",
    "latest_sequence",
    "next_after",
    "truncated",
    "has_more",
    "events"
  ],
  "additionalProperties": false
}
