{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tepy.local/protocol/v1/config.schema.json",
  "title": "Tepy v1 config",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "wifi": {
      "type": "object",
      "properties": {
        "ssid": {
          "type": "string",
          "maxLength": 32
        },
        "password": {
          "type": "string",
          "oneOf": [
            {
              "maxLength": 0
            },
            {
              "minLength": 8,
              "maxLength": 63
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "mqtt": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(|mqtts?://[^\\s@/?#]+)$"
        },
        "username": {
          "type": "string",
          "maxLength": 128
        },
        "password": {
          "type": "string",
          "maxLength": 256
        },
        "ca": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ntp_server": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "key_delay_ms": {
      "type": "integer",
      "minimum": 5,
      "maximum": 200,
      "default": 20
    },
    "admin_password": {
      "type": "string",
      "pattern": "^[!-~]{16,64}$"
    }
  },
  "required": [
    "v"
  ],
  "additionalProperties": false
}
