{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tepy.local/protocol/v1/serial-request.schema.json",
  "title": "Tepy v1 serial management request (without framing)",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "method": {
      "enum": [
        "status.get",
        "config.get",
        "config.secrets.get",
        "config.patch",
        "wifi.scan",
        "ble.pair",
        "ble.passkey",
        "ble.clear",
        "reboot",
        "ota.begin",
        "ota.write",
        "ota.finish",
        "ota.abort"
      ]
    },
    "token": {
      "type": "string",
      "maxLength": 64
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "v",
    "id",
    "method",
    "token",
    "params"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "config.patch"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "$ref": "config.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "ble.passkey"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "passkey": {
                "type": "string",
                "pattern": "^[0-9]{6}$"
              }
            },
            "required": [
              "passkey"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "status.get",
              "config.get",
              "config.secrets.get",
              "wifi.scan",
              "ble.pair",
              "ble.clear",
              "reboot"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "ota.begin"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "device_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{12}$"
              },
              "session": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              "size": {
                "type": "integer",
                "minimum": 289,
                "maximum": 4194304
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "device_id",
              "session",
              "size",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "ota.write"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "upload_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              },
              "data": {
                "type": "string",
                "minLength": 4,
                "maxLength": 4096,
                "contentEncoding": "base64",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
              }
            },
            "required": [
              "upload_id",
              "offset",
              "data"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": [
              "ota.finish",
              "ota.abort"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "upload_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              }
            },
            "required": [
              "upload_id"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
