{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tepy.local/protocol/v1/config-secrets.schema.json",
  "title": "Tepy v1 authenticated configuration secrets (explicit reveal only)",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "wifi": {
      "type": "object",
      "properties": {
        "password": {
          "type": "string",
          "maxLength": 63
        }
      },
      "required": [
        "password"
      ],
      "additionalProperties": false
    },
    "mqtt": {
      "type": "object",
      "properties": {
        "password": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "password"
      ],
      "additionalProperties": false
    },
    "admin_password": {
      "type": "string",
      "pattern": "^[!-~]{16,64}$"
    }
  },
  "required": [
    "v",
    "wifi",
    "mqtt",
    "admin_password"
  ],
  "additionalProperties": false
}
